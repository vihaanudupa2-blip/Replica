<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>REPLICA // Encrypted 4chan Cyberboard & Olive AI Sentinel</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- React & ReactDOM CDN -->
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  
  <!-- Babel Standalone CDN -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <!-- Google Fonts: JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,700;1,400&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'JetBrains Mono', monospace;
      background-color: #080b0e;
      color: #92a3b5;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #0d1217;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #1f2937;
      border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #00ff66;
    }
    .greentext {
      color: #78350f;
      color: #38bdf8;
      color: #7ee787;
    }
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.8; box-shadow: 0 0 10px rgba(0, 255, 102, 0.2); }
      50% { opacity: 1; box-shadow: 0 0 20px rgba(0, 255, 102, 0.6); }
    }
    .olive-active {
      animation: pulse-glow 2s infinite;
    }
    @keyframes wave {
      0%, 100% { height: 8px; }
      50% { height: 32px; }
    }
    .wave-bar {
      animation: wave 1.2s ease-in-out infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-black">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // Inline SVG Icons
    const ShieldIcon = () => (<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>);
    const TerminalIcon = () => (<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>);
    const PhoneIcon = () => (<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>);
    const LockIcon = () => (<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>);
    const UploadIcon = () => (<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>);
    const SendIcon = () => (<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>);
    const CpuIcon = () => (<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/></svg>);
    const MicIcon = () => (<svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>);
    const MicOffIcon = () => (<svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="1" y1="1" x2="23" y2="23"/><path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"/><path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>);

    function ReplicaApp() {
      const [username, setUsername] = useState('Anonymous');
      const [tripcode, setTripcode] = useState('!rEp3x99a');
      const [message, setMessage] = useState('');
      const [attachedFile, setAttachedFile] = useState(null);
      const [isScanning, setIsScanning] = useState(false);
      const [isVoiceActive, setIsVoiceActive] = useState(false);
      const [isMuted, setIsMuted] = useState(false);
      const [isTerminalOpen, setIsTerminalOpen] = useState(false);
      const [oliveStatus, setOliveStatus] = useState({ state: 'DEFENDING', level: 'MAXIMUM', threatCount: 0 });
      const [terminalLogs, setTerminalLogs] = useState([
        `[SYSTEM_BOOT] Replica Security Matrix initialized.`,
        `[OLIVE_AI] Sentinel active. Monitoring network nodes...`,
        `[ENCRYPTION] E2E RSA-4096 / ChaCha20 active on universal link.`,
        `[STATUS] Board protected. Threat level: NOMINAL.`
      ]);

      const [posts, setPosts] = useState([
        {
          id: 849201,
          author: 'Anonymous',
          trip: '!x7K9pQ2m',
          timestamp: new Date(Date.now() - 3600000).toLocaleString(),
          content: `>be me\n>discover replica single link chat\n>no login, no passwords, total privacy\n>olive ai actively scanning for malicious payloads\nfeels good man.`,
          file: null,
          isSystem: false
        },
        {
          id: 849202,
          author: 'OLIVE / JARVIS AI',
          trip: '[SYS_SENTINEL]',
          timestamp: new Date(Date.now() - 1800000).toLocaleString(),
          content: `🛡️ SECURITY SYSTEM NOTICE:\nUniversal link #replica-group-main is monitored and shielded.\nAll incoming file uploads are scanned for malicious shellcode and exploits.\nType /hack or /defend to test board defense capabilities.`,
          file: null,
          isSystem: true
        }
      ]);

      const chatEndRef = useRef(null);

      useEffect(() => {
        chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
      }, [posts]);

      // Tripcode generator
      const updateUsername = (name) => {
        setUsername(name);
        if (name.trim() !== '') {
          let hash = 0;
          for (let i = 0; i < name.length; i++) {
            hash = (hash << 5) - hash + name.charCodeAt(i);
            hash |= 0;
          }
          setTripcode('!' + Math.abs(hash).toString(36).substring(0, 8));
        } else {
          setTripcode('!rEp3x99a');
        }
      };

      const handleFileUpload = (e) => {
        const file = e.target.files[0];
        if (!file) return;

        setIsScanning(true);
        addTerminalLog(`[OLIVE_SCAN] Inspecting uploaded payload: "${file.name}" (${(file.size / 1024).toFixed(1)} KB)...`);

        setTimeout(() => {
          setIsScanning(false);
          setAttachedFile({
            name: file.name,
            size: (file.size / 1024).toFixed(1) + ' KB',
            type: file.type,
            url: file.type.startsWith('image/') ? URL.createObjectURL(file) : null
          });
          addTerminalLog(`[OLIVE_SCAN] Clean! File verified safe: ${file.name}`);
        }, 1200);
      };

      const addTerminalLog = (log) => {
        setTerminalLogs(prev => [...prev.slice(-40), `[${new Date().toLocaleTimeString()}] ${log}`]);
      };

      const executeHackSimulation = () => {
        setIsTerminalOpen(true);
        addTerminalLog(`[PEN_TEST] Initiating AI simulated attack vector against local board...`);
        
        setTimeout(() => {
          addTerminalLog(`[THREAT_DETECTED] Zero-day payload injection attempt blocked by OLIVE.`);
          setOliveStatus(prev => ({ ...prev, threatCount: prev.threatCount + 1 }));
          
          const botPost = {
            id: Math.floor(100000 + Math.random() * 900000),
            author: 'OLIVE / JARVIS AI',
            trip: '[SENTINEL_DEFENSE]',
            timestamp: new Date().toLocaleString(),
            content: `⚡ ALERT: Simulated hack vector mitigated!\nThreat origin: External IP Spoof\nAction taken: Node isolated & encrypted payload incinerated. Board status: 100% SECURE.`,
            file: null,
            isSystem: true
          };
          setPosts(prev => [...prev, botPost]);
        }, 1500);
      };

      const executeDefendAction = () => {
        setIsTerminalOpen(true);
        addTerminalLog(`[DEFENSE_SHIELD] Deploying quantum counter-measures and rotating trip keys...`);
        setTimeout(() => {
          addTerminalLog(`[DEFENSE_SHIELD] Board defensive perimeter reinforced. Firewall status: OPTIMAL.`);
        }, 1000);
      };

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!message.trim() && !attachedFile) return;

        const currentMsg = message.trim();

        // Check for quick commands
        if (currentMsg === '/hack') {
          setMessage('');
          executeHackSimulation();
          return;
        }
        if (currentMsg === '/defend') {
          setMessage('');
          executeDefendAction();
          return;
        }

        const newPost = {
          id: Math.floor(100000 + Math.random() * 900000),
          author: username.trim() || 'Anonymous',
          trip: tripcode,
          timestamp: new Date().toLocaleString(),
          content: currentMsg,
          file: attachedFile,
          isSystem: false
        };

        setPosts(prev => [...prev, newPost]);
        setMessage('');
        setAttachedFile(null);

        // Simulated AI response if mentioning Olive/Jarvis
        if (currentMsg.toLowerCase().includes('olive') || currentMsg.toLowerCase().includes('jarvis')) {
          setTimeout(() => {
            const botReply = {
              id: Math.floor(100000 + Math.random() * 900000),
              author: 'OLIVE / JARVIS AI',
              trip: '[SYS_SENTINEL]',
              timestamp: new Date().toLocaleString(),
              content: `Awaiting instructions. Board status is nominal. Node security: 100%. All universal chat links are currently protected against eavesdropping and injection.`,
              file: null,
              isSystem: true
            };
            setPosts(prev => [...prev, botReply]);
          }, 1000);
        }
      };

      const formatGreentext = (text) => {
        return text.split('\n').map((line, idx) => {
          if (line.startsWith('>')) {
            return <div key={idx} className="text-emerald-400 font-mono">{line}</div>;
          }
          return <div key={idx}>{line}</div>;
        });
      };

      return (
        <div className="flex-1 flex flex-col max-w-6xl w-full mx-auto p-2 sm:p-4">
          
          <!-- TOP HEADER BAR -->
          <header className="bg-gray-900/90 border border-emerald-900/50 rounded-lg p-3 sm:p-4 mb-4 flex flex-wrap items-center justify-between gap-3 shadow-lg shadow-emerald-950/20 backdrop-blur">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded bg-emerald-950 border border-emerald-500/40 flex items-center justify-center text-emerald-400 olive-active">
                <CpuIcon />
              </div>
              <div>
                <div className="flex items-center gap-2">
                  <h1 className="text-xl font-bold tracking-wider text-emerald-400 uppercase">REPLICA</h1>
                  <span className="text-xs px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800">
                    4CHAN-MODE
                  </span>
                </div>
                <p className="text-xs text-gray-400 flex items-center gap-1.5 mt-0.5">
                  <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  Node: <span className="text-emerald-400 font-mono">#replica-group-main</span> (Single Universal Link)
                </p>
              </div>
            </div>

            <div className="flex items-center gap-2">
              <button
                onClick={() => setIsVoiceActive(!isVoiceActive)}
                className={`px-3 py-1.5 rounded text-xs font-semibold flex items-center gap-2 border transition ${
                  isVoiceActive 
                    ? 'bg-emerald-500 text-black border-emerald-400 shadow-md shadow-emerald-500/20' 
                    : 'bg-gray-800 text-emerald-400 border-emerald-900 hover:border-emerald-500'
                }`}
              >
                <PhoneIcon />
                {isVoiceActive ? 'VOICE CONNECTED' : 'CONNECT VOICE'}
              </button>

              <button
                onClick={() => setIsTerminalOpen(!isTerminalOpen)}
                className="px-3 py-1.5 rounded text-xs font-semibold flex items-center gap-2 bg-gray-800 text-gray-300 border border-gray-700 hover:border-emerald-500 hover:text-emerald-400 transition"
              >
                <TerminalIcon />
                OLIVE TERMINAL
              </button>
            </div>
          </header>

          <!-- DEFENSE SYSTEM STATUS BANNER -->
          <div className="bg-gray-900/60 border border-gray-800 rounded-lg p-2.5 mb-4 text-xs flex flex-wrap items-center justify-between gap-2">
            <div className="flex items-center gap-4">
              <div className="flex items-center gap-1.5 text-emerald-400 font-semibold">
                <ShieldIcon />
                <span>OLIVE / JARVIS: <span className="text-emerald-300">ACTIVE DEFENSE</span></span>
              </div>
              <div className="hidden sm:block text-gray-400">
                Threat Neutralized: <span className="text-emerald-400 font-bold">{oliveStatus.threatCount}</span>
              </div>
            </div>

            <div className="flex items-center gap-2">
              <button
                onClick={executeHackSimulation}
                className="px-2 py-1 bg-red-950/60 text-red-400 border border-red-800/60 rounded hover:bg-red-900/50 transition text-[11px]"
              >
                ⚡ /hack (PenTest)
              </button>
              <button
                onClick={executeDefendAction}
                className="px-2 py-1 bg-emerald-950/60 text-emerald-400 border border-emerald-800/60 rounded hover:bg-emerald-900/50 transition text-[11px]"
              >
                🛡️ /defend (Shield)
              </button>
            </div>
          </div>

          <!-- MAIN CHAT FEED -->
          <div className="flex-1 bg-gray-950/80 border border-gray-800 rounded-lg p-3 sm:p-4 overflow-y-auto mb-4 space-y-4 custom-scrollbar min-h-[420px] max-h-[550px]">
            {posts.map((post) => (
              <div
                key={post.id}
                className={`p-3 rounded border transition ${
                  post.isSystem
                    ? 'bg-emerald-950/20 border-emerald-800/60 text-emerald-300'
                    : 'bg-gray-900/50 border-gray-800/80 hover:border-gray-700'
                }`}
              >
                <!-- POST HEADER -->
                <div className="flex flex-wrap items-center gap-2 text-xs border-b border-gray-800/80 pb-1.5 mb-2">
                  <span className={`font-bold ${post.isSystem ? 'text-emerald-400' : 'text-emerald-500'}`}>
                    {post.author}
                  </span>
                  <span className="text-emerald-700 font-mono text-[11px]">{post.trip}</span>
                  <span className="text-gray-500">{post.timestamp}</span>
                  <span className="text-gray-600 font-mono ml-auto">No.{post.id}</span>
                </div>

                <!-- FILE ATTACHMENT DISPLAY -->
                {post.file && (
                  <div className="mb-2 p-2 bg-gray-900 border border-gray-800 rounded flex items-center gap-3 text-xs">
                    {post.file.url ? (
                      <img src={post.file.url} alt="Attached file" className="w-16 h-16 object-cover rounded border border-gray-700" />
                    ) : (
                      <div className="w-10 h-10 bg-gray-800 rounded flex items-center gap-1 justify-center text-emerald-400">
                        📄
                      </div>
                    )}
                    <div>
                      <div className="font-semibold text-gray-200">{post.file.name}</div>
                      <div className="text-gray-500 text-[11px]">{post.file.size}</div>
                      <div className="text-emerald-400 text-[10px] flex items-center gap-1 mt-0.5">
                        <span>✓ Scanned by Olive AI</span>
                      </div>
                    </div>
                  </div>
                )}

                <!-- POST CONTENT -->
                <div className="text-sm text-gray-300 whitespace-pre-wrap leading-relaxed font-mono">
                  {formatGreentext(post.content)}
                </div>
              </div>
            ))}
            <div ref={chatEndRef} />
          </div>

          <!-- INPUT & FILE ATTACH SECTION -->
          <form onSubmit={handleSubmit} className="bg-gray-900/90 border border-gray-800 rounded-lg p-3 sm:p-4 space-y-3">
            
            {/* USERNAME & TRIPCODE BAR */}
            <div className="flex flex-wrap items-center gap-3 text-xs">
              <div className="flex items-center gap-2 bg-gray-950 border border-gray-800 rounded px-2.5 py-1.5">
                <span className="text-gray-500">Name:</span>
                <input
                  type="text"
                  value={username}
                  onChange={(e) => updateUsername(e.target.value)}
                  placeholder="Anonymous"
                  className="bg-transparent text-emerald-400 font-semibold focus:outline-none w-28"
                />
              </div>

              <div className="text-gray-500 font-mono">
                Tripcode: <span className="text-emerald-600">{tripcode}</span>
              </div>

              {attachedFile && (
                <div className="flex items-center gap-2 bg-emerald-950/60 border border-emerald-800 text-emerald-300 px-2.5 py-1 rounded">
                  <span>📎 {attachedFile.name}</span>
                  <button type="button" onClick={() => setAttachedFile(null)} className="text-red-400 font-bold ml-1">✕</button>
                </div>
              )}

              {isScanning && (
                <span className="text-amber-400 animate-pulse text-[11px]">Scanning file with Olive AI...</span>
              )}
            </div>

            {/* TEXTAREA INPUT */}
            <textarea
              value={message}
              onChange={(e) => setMessage(e.target.value)}
              placeholder="Type message or greentext (>like this)... commands: /hack, /defend"
              rows="3"
              className="w-full bg-gray-950 border border-gray-800 rounded p-2.5 text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-emerald-500/60 font-mono resize-none"
              onKeyDown={(e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                  e.preventDefault();
                  handleSubmit(e);
           
